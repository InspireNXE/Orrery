<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>0.1.0</Version>
    <Authors>Steven Downer</Authors>
    <Company>InspireNXE</Company>
    <Copyright>Copyright (c) 2026 InspireNXE</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <AvaloniaVersion>11.3.22</AvaloniaVersion>
    <IronRdpVersion>2026.10.29</IronRdpVersion>
    <BouncyCastleVersion>2.7.0</BouncyCastleVersion>
  </PropertyGroup>
</Project>
