<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Devolutions.IronRdp built from a fork of IronRDP, for the RDP clipboard on Linux and macOS. It isn't on
         nuget.org: build/Get-IronRdp.ps1 puts it in .nuget-local (beside this file, not committed). A restore that
         fails with NU1301 or NU1101 for this source means that hasn't been run yet. Remove this source, its mapping
         and the -orrery suffix in Directory.Build.props to go back to nuget.org's package. -->
    <add key="ironrdp-local" value=".nuget-local" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ironrdp-local">
      <package pattern="Devolutions.IronRdp" />
    </packageSource>
  </packageSourceMapping>
</configuration>