<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Devolutions.IronRdp built locally from the orrery/cliprdr-callback-v2 branch of IronRDP, for the RDP clipboard on
         Linux and macOS. Remove this source, its mapping and the -orrery suffix in Directory.Build.props to go back
         to nuget.org's package. -->
    <add key="ironrdp-local" value="W:\IronRDP\dependencies\nuget" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="ironrdp-local">
      <package pattern="Devolutions.IronRdp" />
    </packageSource>
  </packageSourceMapping>
</configuration>