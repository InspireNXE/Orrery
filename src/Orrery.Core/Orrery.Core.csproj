<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- WinRt.cs calls Windows Hello's WinRT methods through their vtables (docs/design-biometric-unlock.md §6.1). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="$(BouncyCastleVersion)" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Orrery.Core.Tests" />
  </ItemGroup>
</Project>
