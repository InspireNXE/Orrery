<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orrery.App.Connections"
        xmlns:c="using:Orrery.App.Controls"
        xmlns:s="using:Orrery.App.Sessions"
        x:Class="Orrery.App.MainWindow"
        Title="Orrery"
        Icon="/Assets/orrery.ico"
        Width="1440" Height="900" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        FontSize="13"
        Background="{StaticResource OrreryBackground}"
        Foreground="{StaticResource OrreryText}">
  <Grid x:Name="Root">
    <DockPanel>

      <!-- Title bar: the window's own chrome, with quick connect in the middle. -->
      <Border x:Name="TitleBar" DockPanel.Dock="Top" Height="44"
              Background="{StaticResource OrreryBackground}"
              BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,0,1">
        <Grid x:Name="TitleBarGrid" ColumnDefinitions="160,*,160">
          <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="10" Margin="14,0,16,0" VerticalAlignment="Center" IsHitTestVisible="False">
            <Viewbox Width="24" Height="24">
              <Canvas Width="24" Height="24">
                <Ellipse Width="20" Height="8.4" Canvas.Left="2" Canvas.Top="7.8"
                         Stroke="{StaticResource OrreryAccent}" StrokeThickness="1.4" Opacity="0.5">
                  <Ellipse.RenderTransform><RotateTransform Angle="-25" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="12.4" Height="5.2" Canvas.Left="5.8" Canvas.Top="9.4"
                         Stroke="{StaticResource OrreryAccent}" StrokeThickness="1.4">
                  <Ellipse.RenderTransform><RotateTransform Angle="-25" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="5.2" Height="5.2" Canvas.Left="9.4" Canvas.Top="9.4" Fill="{StaticResource OrreryAccent}" />
                <Ellipse Width="3.2" Height="3.2" Canvas.Left="19.46" Canvas.Top="6.17" Fill="{StaticResource OrreryText}" />
                <Ellipse Width="2.4" Height="2.4" Canvas.Left="5.18" Canvas.Top="13.42" Fill="{StaticResource OrreryText}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Orrery" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <Button x:Name="QuickConnectButton" Grid.Column="1" Classes="search"
                  HorizontalAlignment="Stretch" MaxWidth="520" Height="30" VerticalAlignment="Center"
                  Click="OnQuickConnectClick" ToolTip.Tip="Quick connect (Ctrl+K, or Ctrl+Shift+K from a terminal)"
                  AutomationProperties.Name="Quick connect">
            <DockPanel>
              <Border DockPanel.Dock="Right" BorderBrush="{StaticResource OrreryControlBorder}" BorderThickness="1"
                      CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                <TextBlock x:Name="QuickConnectShortcut" Text="Ctrl K" Classes="mono" FontSize="11" Foreground="{StaticResource OrreryMuted}" />
              </Border>
              <c:StrokeIcon DockPanel.Dock="Left" Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0"
                            Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M20 20l-3.5-3.5" />
              <TextBlock Text="Quick connect: host, user@host, rdp://, ssh:// or search" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" Foreground="{StaticResource OrreryMuted}" />
            </DockPanel>
          </Button>

          <!-- The side columns match, so quick connect sits in the middle of the window. The right one
               leaves room for the system's minimize, maximize and close buttons. -->
        </Grid>
      </Border>

      <!-- Offered at start-up when sessions were open last time. -->
      <Border x:Name="RestoreBar" DockPanel.Dock="Top" IsVisible="False" Padding="14,4"
              Background="{StaticResource OrreryPanel}" BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,0,1">
        <DockPanel>
          <Button x:Name="RestoreDismissButton" DockPanel.Dock="Right" MinHeight="26" Content="Not now" />
          <Button x:Name="RestoreReopenButton" DockPanel.Dock="Right" Classes="accent" MinHeight="26" Content="Reopen" Margin="0,0,8,0" />
          <TextBlock x:Name="RestoreText" VerticalAlignment="Center" Foreground="{StaticResource OrrerySoftText}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!-- Status bar -->
      <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="26" Padding="14,0"
              BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,1,0,0">
        <DockPanel>
          <TextBlock x:Name="ModeText" DockPanel.Dock="Right" FontSize="11" Foreground="{StaticResource OrreryMuted}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <TextBlock x:Name="SessionCountText" FontSize="11" Foreground="{StaticResource OrreryMuted}" />
            <!-- The path in the mono font, as paths are everywhere else. -->
            <StackPanel x:Name="StorageLine" Orientation="Horizontal" Spacing="5">
              <TextBlock Text="Data:" FontSize="11" Foreground="{StaticResource OrreryMuted}" />
              <TextBlock x:Name="StorageText" FontSize="11" FontFamily="{StaticResource OrreryMono}" Foreground="{StaticResource OrreryMuted}"
                         TextTrimming="CharacterEllipsis" MaxWidth="660" />
            </StackPanel>
            <c:Notice x:Name="DataAccessText" Kind="Warning" IconSize="12" VerticalAlignment="Center" IsVisible="False" />
            <TextBlock x:Name="NoticeText" FontSize="11" Foreground="{StaticResource OrreryMuted}" IsVisible="False" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid x:Name="Panes" ColumnDefinitions="Auto,Auto,*,Auto,Auto">

        <!-- Activity rail -->
        <Border x:Name="Rail" Width="52" BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,1,0" Padding="0,10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Spacing="4" HorizontalAlignment="Center">
              <Button x:Name="LockVaultButton" Classes="icon rail" Click="OnLockVaultClick" IsVisible="False"
                      ToolTip.Tip="Lock the vault" AutomationProperties.Name="Lock the vault">
                <c:StrokeIcon Width="20" Height="20" Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4" />
              </Button>
              <Button x:Name="SettingsRailButton" Classes="icon rail" Click="OnSettingsClick" ToolTip.Tip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                <c:StrokeIcon Width="20" Height="20" Data="M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0 M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" />
              </Button>
            </StackPanel>
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <Button x:Name="ConnectionsRailButton" Classes="icon rail active" Click="OnRailClick" Tag="connections"
                      ToolTip.Tip="Connections" AutomationProperties.Name="Connections">
                <c:StrokeIcon Width="20" Height="20" Data="M5 4h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M8 20h8 M12 16v4" />
              </Button>
              <Button x:Name="RecentRailButton" Classes="icon rail" Click="OnRailClick" Tag="recent"
                      ToolTip.Tip="Recent connections" AutomationProperties.Name="Recent">
                <c:StrokeIcon Width="20" Height="20" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0 M12 7v5l3 2" />
              </Button>
              <Button x:Name="CommandsRailButton" Classes="icon rail" Click="OnRailClick" Tag="commands"
                      ToolTip.Tip="Saved commands" AutomationProperties.Name="Commands">
                <c:StrokeIcon Width="20" Height="20" Data="M4 17l6-5-6-5 M12 19h8" />
              </Button>
              <Button x:Name="CredentialsRailButton" Classes="icon rail" Click="OnRailClick" Tag="credentials"
                      ToolTip.Tip="Saved credentials" AutomationProperties.Name="Credentials">
                <c:StrokeIcon Width="20" Height="20" Data="M4 15a4 4 0 1 0 8 0a4 4 0 1 0-8 0 M11 12l9-9 M17 6l3 3 M15 8l2 2" />
              </Button>
              <Button x:Name="RecordingsRailButton" Classes="icon rail" Click="OnRailClick" Tag="recordings"
                      ToolTip.Tip="Recordings" AutomationProperties.Name="Recordings">
                <c:StrokeIcon Width="20" Height="20" Data="M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0 M9 12a3 3 0 1 0 6 0a3 3 0 1 0-6 0" />
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Side panel: the rail picks connections, recent, commands, credentials or recordings. -->
        <Border x:Name="SidePanel" Grid.Column="1" Width="280"
                Background="{StaticResource OrreryPanel}"
                BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,1,0">
          <Panel>
            <ContentControl x:Name="CredentialsSide" IsVisible="False" />
            <ContentControl x:Name="RecentSide" IsVisible="False" />
            <ContentControl x:Name="CommandsSide" IsVisible="False" />
            <ContentControl x:Name="RecordingsSide" IsVisible="False" />
            <DockPanel x:Name="ConnectionsSide">
              <DockPanel DockPanel.Dock="Top" Margin="14,10,10,6">
                <StackPanel x:Name="ConnectionsHeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                  <Button x:Name="NewFolderButton" Classes="icon" Width="28" Height="28" Click="OnNewFolderClick"
                          ToolTip.Tip="New folder" AutomationProperties.Name="New folder">
                    <c:StrokeIcon Data="M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z M12 10v6 M9 13h6" />
                  </Button>
                  <Button x:Name="NewConnectionButton" Classes="icon" Width="28" Height="28" Click="OnNewConnectionClick"
                          ToolTip.Tip="New connection" AutomationProperties.Name="New connection">
                    <c:StrokeIcon StrokeThickness="2" Data="M12 5v14 M5 12h14" />
                  </Button>
                </StackPanel>
                <TextBlock Classes="section" Text="CONNECTIONS" VerticalAlignment="Center" />
              </DockPanel>
  
              <TextBox x:Name="FilterBox" DockPanel.Dock="Top" PlaceholderText="Filter" AutomationProperties.Name="Filter connections" Margin="12,0,12,10" FontSize="12" MinHeight="30">
                <TextBox.InnerLeftContent>
                  <c:StrokeIcon Width="13" Height="13" StrokeThickness="2" Margin="10,0,0,0" Foreground="{StaticResource OrreryMuted}"
                                Data="M4 6h16 M7 12h10 M10 18h4" />
                </TextBox.InnerLeftContent>
              </TextBox>
  
              <Grid>
                <vm:ConnectionTreeView x:Name="Tree" Background="Transparent" DragDrop.AllowDrop="True" Padding="12,0" SelectionMode="Multiple"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="Connections">
                  <TreeView.Styles>
                    <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
                      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                  </TreeView.Styles>
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                      <DockPanel Background="Transparent" Margin="0,0,8,0">
                        <Border DockPanel.Dock="Right" IsVisible="{Binding IsConnection}" Background="{Binding BadgeBackground}"
                                CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Medium" Foreground="{Binding BadgeForeground}"
                                     FontFamily="{StaticResource OrreryMono}" />
                        </Border>
                        <!-- Whether the host is up, beside the protocol badge: both are about the host. The session's own
                             state is the mark before the name, as on its tab. -->
                        <Border DockPanel.Dock="Right" IsVisible="{Binding ReachabilityShown}" Background="Transparent" Padding="3" Margin="5,0,0,0"
                                VerticalAlignment="Center" ToolTip.Tip="{Binding ReachabilityTip}" AutomationProperties.Name="{Binding ReachabilityTip}">
                          <c:HostGlyph State="{Binding Reachability}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" IsVisible="{Binding IsFolder}" Text="{Binding Count}" FontSize="11"
                                   Foreground="#8A93A3" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" IsVisible="{Binding IsHost}" Text="{Binding GuestCount}" FontSize="11"
                                   Foreground="#8A93A3" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip.Tip="Guests" />
                        <c:StrokeIcon DockPanel.Dock="Left" IsVisible="{Binding IsFolder}" Width="15" Height="15" Margin="0,0,8,0"
                                      Foreground="{StaticResource OrreryFolder}"
                                      Data="M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                        <c:StateGlyph DockPanel.Dock="Left" IsVisible="{Binding IsConnection}" Width="8" Height="8" Margin="1,0,9,0"
                                      State="{Binding Status}" ToolTip.Tip="{Binding SessionTip}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Detail}" />
                      </DockPanel>
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                  <TreeView.ContextMenu>
                    <ContextMenu>
                      <MenuItem x:Name="ConnectMenuItem" Header="Connect" Click="OnConnectMenuClick" />
                      <MenuItem x:Name="NewSessionMenuItem" Header="Open new session" Click="OnNewSessionMenuClick" />
                      <MenuItem x:Name="BrowseFilesMenuItem" Header="Browse files (SFTP)" Click="OnBrowseFilesMenuClick" />
                      <MenuItem x:Name="WakeMenuItem" Header="Wake" Click="OnWakeMenuClick" />
                      <MenuItem x:Name="ManagementMenuItem" Header="Open management page" Click="OnManagementMenuClick" />
                      <Separator />
                      <MenuItem Header="New connection" Click="OnNewConnectionClick" />
                      <MenuItem Header="New folder" Click="OnNewFolderClick" />
                      <MenuItem Header="Local terminal" Click="OnLocalTerminalClick" InputGesture="Ctrl+Shift+T" />
                      <MenuItem x:Name="ElevatedTerminalMenuItem" Header="Local terminal as administrator" Click="OnElevatedTerminalClick" />
                      <Separator />
                      <MenuItem Header="Open Remote Desktop file…" Click="OnOpenRdpFileClick" />
                      <MenuItem Header="Import…" Click="OnImportMenuClick" />
                      <Separator />
                      <MenuItem x:Name="AddGuestMenuItem" Header="Add guest" Click="OnAddGuestMenuClick" />
                      <MenuItem x:Name="MoveOutOfHostMenuItem" Header="Move out of host" Click="OnMoveOutOfHostMenuClick" />
                      <MenuItem x:Name="DuplicateMenuItem" Header="Duplicate" Click="OnDuplicateMenuClick" InputGesture="Ctrl+D" />
                      <MenuItem x:Name="ExportMenuItem" Header="Export…" Click="OnExportMenuClick" />
                      <Separator />
                      <MenuItem Header="Defaults for all connections…" Click="OnEditDefaultsClick" />
                      <Separator />
                      <MenuItem x:Name="DeleteMenuItem" Header="Delete" Click="OnDeleteMenuClick" InputGesture="Delete" />
                    </ContextMenu>
                  </TreeView.ContextMenu>
                </vm:ConnectionTreeView>
                <TextBlock x:Name="TreeEmptyState" TextWrapping="Wrap" Foreground="{StaticResource OrreryMuted}" Margin="14,6,14,8" LineHeight="19"
                           Text="No saved connections yet. Add one with +, use Quick connect, or import them in Settings." />
              </Grid>
            </DockPanel>
          </Panel>
        </Border>

        <!-- Sessions -->
        <DockPanel Grid.Column="2">
          <!-- Says a newer Orrery is out (MainWindow.Updates.cs); never over a session. -->
          <ContentControl DockPanel.Dock="Top" x:Name="UpdateBarHost" />
          <Border DockPanel.Dock="Top" x:Name="TabStripBar" Background="{StaticResource OrreryPanel}"
                  BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,0,1" Padding="10,8,10,0">
            <DockPanel>
              <!-- Hide or show the panes on either side, for more room for the session. -->
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" Margin="8,0,0,4" VerticalAlignment="Center">
                <!-- Every open tab in a list, as a browser's tab search, for when they're squeezed or scrolled away. -->
                <Button x:Name="TabListButton" Classes="icon small" Click="OnTabListClick" IsVisible="False"
                        ToolTip.Tip="All tabs" AutomationProperties.Name="All tabs">
                  <c:StrokeIcon Width="16" Height="16" Data="M6 9l6 6 6-6" />
                </Button>
                <Button x:Name="SidePanelToggle" Classes="icon small" Click="OnToggleSidePanelClick"
                        AutomationProperties.Name="Toggle side panel">
                  <c:StrokeIcon Width="16" Height="16" Data="M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M9 4v16" />
                </Button>
                <Button x:Name="InspectorToggle" Classes="icon small" Click="OnToggleInspectorClick"
                        AutomationProperties.Name="Toggle properties pane">
                  <c:StrokeIcon Width="16" Height="16" Data="M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z M15 4v16" />
                </Button>
              </StackPanel>
            <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <s:TabStripPanel x:Name="TabStrip" Spacing="2" VerticalAlignment="Bottom"
                            AutomationProperties.Name="Sessions" AutomationProperties.AccessibilityView="Control" AutomationProperties.ControlTypeOverride="Tab" />
                <Button Classes="icon" Width="32" Height="32" Margin="2,0,0,1" VerticalAlignment="Bottom" CornerRadius="6"
                        Click="OnQuickConnectClick" ToolTip.Tip="New session (Ctrl+K)" AutomationProperties.Name="New session">
                  <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="M12 5v14 M5 12h14" />
                </Button>
                <Button x:Name="LocalTerminalButton" Classes="icon" Width="32" Height="32" Margin="0,0,0,1" VerticalAlignment="Bottom" CornerRadius="6"
                        Click="OnLocalTerminalClick" ToolTip.Tip="Local terminal (Ctrl+Shift+T)" AutomationProperties.Name="Local terminal">
                  <c:StrokeIcon Width="14" Height="14" StrokeThickness="2" Data="M4 17l6-5-6-5 M12 19h8" />
                </Button>
              </StackPanel>
            </ScrollViewer>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Top" x:Name="SessionToolbar" IsVisible="False" Padding="14,7"
                  BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel x:Name="SessionActions" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" />
              <!-- Docked rather than stacked, as in a popped-out session's bar, so in a narrow window the address and
                   detail are cut short with an ellipsis instead of running under the buttons. -->
              <DockPanel ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center">
                <DockPanel DockPanel.Dock="Left" Margin="0,0,14,0">
                  <c:StrokeIcon x:Name="SessionLock" DockPanel.Dock="Left" Width="14" Height="14" StrokeThickness="2" Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Data="M7 11h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z M8 11V7a4 4 0 0 1 8 0v4" />
                  <TextBlock x:Name="SessionAddress" Classes="mono" FontSize="12" Foreground="{StaticResource OrrerySoftText}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="SessionDetail" FontSize="12" Foreground="#8A93A3" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DockPanel>
          </Border>

          <Grid>
            <s:SessionSplitPanel x:Name="SessionHost" Background="#0B0D10" />
            <StackPanel x:Name="EmptyState" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock x:Name="EmptyStateTitle" Text="No open sessions" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Foreground="{StaticResource OrreryMuted}" HorizontalAlignment="Center"
                         Text="Double-click a connection, or press Ctrl+K to quick connect." />
              <TextBlock x:Name="EmptyStateLocal" Foreground="{StaticResource OrreryMuted}" HorizontalAlignment="Center"
                         Text="Ctrl+Shift+T opens a terminal on this computer." />
            </StackPanel>
          </Grid>
        </DockPanel>

        <!-- A hidden pane opens over the sessions when the pointer reaches the window's edge (MainWindow.Panes.cs). -->
        <Border Grid.Column="2" x:Name="LeftEdge" Width="4" HorizontalAlignment="Left" Background="Transparent" IsVisible="False" ZIndex="5" />
        <Border Grid.Column="2" x:Name="RightEdge" Width="4" HorizontalAlignment="Right" Background="Transparent" IsVisible="False" ZIndex="5" />

        <!-- The right-hand pane collapsed to its icon. -->
        <Border Grid.Column="3" x:Name="InspectorStrip" Width="52" IsVisible="False" Padding="0,10"
                Background="{StaticResource OrreryPanel}"
                BorderBrush="{StaticResource OrreryBorder}" BorderThickness="1,0,0,0">
          <Button x:Name="InspectorStripButton" Classes="icon rail" VerticalAlignment="Top" HorizontalAlignment="Center" Click="OnInspectorStripClick"
                  ToolTip.Tip="Properties of the selected connection" AutomationProperties.Name="Show the properties pane">
            <c:StrokeIcon Width="18" Height="18" Data="M4 6h10 M18 6h2 M4 12h4 M12 12h8 M4 18h12 M20 18h0 M14 4v4 M8 10v4 M16 16v4" />
          </Button>
        </Border>

        <!-- Properties of the selected connection or folder -->
        <Border Grid.Column="4" x:Name="PropertiesHost" Width="320"
                Background="{StaticResource OrreryPanel}"
                BorderBrush="{StaticResource OrreryBorder}" BorderThickness="1,0,0,0" />

        <!-- Recordings: the player for the recording chosen in the side panel, over the sessions and the right-hand pane. -->
        <ContentControl Grid.Column="2" Grid.ColumnSpan="3" x:Name="RecordingsHost" IsVisible="False" ZIndex="4"
                        Background="{StaticResource OrreryPanel}" />

        <!-- Settings: a page of its own over everything right of the rail; sessions keep running underneath. -->
        <ContentControl Grid.Column="1" Grid.ColumnSpan="4" x:Name="SettingsHost" IsVisible="False" ZIndex="20" />
      </Grid>
    </DockPanel>

    <!-- Full screen: the session fills the screen, and this bar slides in when the pointer reaches the top. The strip
         that shows it only marks where: clicks there go to the session underneath. -->
    <Border x:Name="FullScreenHotZone" Height="6" VerticalAlignment="Top" Background="Transparent" IsVisible="False"
            IsHitTestVisible="False" />
    <Border x:Name="FullScreenBar" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,0,0,0"
            Background="{StaticResource OrreryPanel}" BorderBrush="{StaticResource OrreryControlBorder}" BorderThickness="1,0,1,1"
            CornerRadius="0,0,10,10" Padding="14,6,8,6">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="FullScreenTitle" VerticalAlignment="Center" FontWeight="SemiBold" />
        <StackPanel x:Name="FullScreenRecording" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="False">
          <Ellipse Width="8" Height="8" Fill="#E5484D" VerticalAlignment="Center" />
          <TextBlock x:Name="FullScreenRecordingText" Text="Recording" VerticalAlignment="Center" FontSize="12" Foreground="#E5484D" />
        </StackPanel>
        <TextBlock x:Name="FullScreenHint" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource OrreryMuted}" />
        <Button Content="Exit full screen" Click="OnExitFullScreenClick" />
      </StackPanel>
    </Border>

    <!-- Dims the window while the quick connect palette is open. -->
    <Border x:Name="Dimmer" Background="#9E050608" IsVisible="False" />
  </Grid>
</Window>
