<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Orrery.App.Connections"
        x:Class="Orrery.App.MainWindow"
        Title="Orrery"
        Width="1440" Height="900" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource OrreryBackground}"
        Foreground="{StaticResource OrreryText}">
  <Grid ColumnDefinitions="280,*,Auto">

    <!-- Connection tree -->
    <Border Background="{StaticResource OrreryPanel}"
            BorderBrush="{StaticResource OrreryBorder}" BorderThickness="0,0,1,0"
            Padding="12,14,12,12">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="4,0,4,10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Viewbox Width="24" Height="24">
              <Canvas Width="24" Height="24">
                <Ellipse Width="20" Height="8.4" Canvas.Left="2" Canvas.Top="7.8"
                         Stroke="{StaticResource OrreryAccent}" StrokeThickness="1.4" Opacity="0.5">
                  <Ellipse.RenderTransform><RotateTransform Angle="-25" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="12.4" Height="5.2" Canvas.Left="5.8" Canvas.Top="9.4"
                         Stroke="{StaticResource OrreryAccent}" StrokeThickness="1.4">
                  <Ellipse.RenderTransform><RotateTransform Angle="-25" /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="5.2" Height="5.2" Canvas.Left="9.4" Canvas.Top="9.4" Fill="{StaticResource OrreryAccent}" />
                <Ellipse Width="3.2" Height="3.2" Canvas.Left="19.46" Canvas.Top="6.17" Fill="{StaticResource OrreryText}" />
                <Ellipse Width="2.4" Height="2.4" Canvas.Left="5.18" Canvas.Top="13.42" Fill="{StaticResource OrreryText}" />
              </Canvas>
            </Viewbox>
            <TextBlock Text="Orrery" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>

          <Button x:Name="QuickConnectButton" HorizontalAlignment="Stretch" Click="OnQuickConnectClick">
            <DockPanel>
              <TextBlock DockPanel.Dock="Right" Text="Ctrl K" FontSize="11" Foreground="{StaticResource OrreryMuted}" VerticalAlignment="Center" />
              <TextBlock Text="Quick connect…" Foreground="{StaticResource OrreryMuted}" />
            </DockPanel>
          </Button>

          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
              <Button x:Name="NewFolderButton" Content="+ Folder" FontSize="11" Padding="6,2" Click="OnNewFolderClick" ToolTip.Tip="New folder" />
              <Button x:Name="NewConnectionButton" Content="+ Connection" FontSize="11" Padding="6,2" Click="OnNewConnectionClick" ToolTip.Tip="New connection" />
            </StackPanel>
            <TextBlock Classes="section" Text="CONNECTIONS" VerticalAlignment="Center" />
          </DockPanel>

          <TextBox x:Name="FilterBox" Watermark="Filter" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,10,4,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Import…" FontSize="12" Click="OnImportClick" ToolTip.Tip="Import connections from mRemoteNG (confCons.xml). You can also drop the file on the list." />
            <Button Content="Credentials…" FontSize="12" Click="OnManageCredentialsClick" />
            <Button x:Name="LockVaultButton" Content="Lock vault" FontSize="12" Click="OnLockVaultClick" IsVisible="False" />
            <Button Content="Settings…" FontSize="12" Click="OnSettingsClick" ToolTip.Tip="Settings (Ctrl+,)" />
          </StackPanel>
          <TextBlock x:Name="StorageText" FontSize="11" Foreground="{StaticResource OrreryMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Grid>
          <TreeView x:Name="Tree" Background="Transparent" DragDrop.AllowDrop="True">
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                <Setter Property="MinHeight" Value="30" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
                <DockPanel Background="Transparent">
                  <Border DockPanel.Dock="Right" IsVisible="{Binding IsConnection}" Background="#1D2E45"
                          CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#8CC2FF"
                               FontFamily="Cascadia Mono, Consolas, Menlo, monospace" />
                  </Border>
                  <PathIcon DockPanel.Dock="Left" IsVisible="{Binding IsFolder}" Width="14" Height="14" Margin="0,0,8,0"
                            Foreground="#E0B45A"
                            Data="M3 6a1 1 0 0 1 1-1h5l2 2h9a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z" />
                  <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Detail}" />
                </DockPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem x:Name="ConnectMenuItem" Header="Connect" Click="OnConnectMenuClick" />
                <Separator />
                <MenuItem Header="New connection" Click="OnNewConnectionClick" />
                <MenuItem Header="New folder" Click="OnNewFolderClick" />
                <MenuItem x:Name="DuplicateMenuItem" Header="Duplicate" Click="OnDuplicateMenuClick" InputGesture="Ctrl+D" />
                <Separator />
                <MenuItem Header="Defaults for all connections…" Click="OnEditDefaultsClick" />
                <Separator />
                <MenuItem x:Name="DeleteMenuItem" Header="Delete" Click="OnDeleteMenuClick" InputGesture="Delete" />
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
          <TextBlock x:Name="TreeEmptyState" TextWrapping="Wrap" Foreground="{StaticResource OrreryMuted}" Margin="6,8"
                     Text="No saved connections yet. Add one with + Connection, or use Quick connect." />
        </Grid>
      </DockPanel>
    </Border>

    <!-- Sessions -->
    <Grid Grid.Column="1">
      <TabControl x:Name="Sessions" Padding="0" />
      <TextBlock x:Name="EmptyState" Text="No open sessions. Double-click a connection, or press Ctrl+K."
                 Foreground="{StaticResource OrreryMuted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>

    <!-- Properties of the selected connection or folder -->
    <Border Grid.Column="2" x:Name="PropertiesHost" Width="320"
            Background="{StaticResource OrreryPanel}"
            BorderBrush="{StaticResource OrreryBorder}" BorderThickness="1,0,0,0" />
  </Grid>
</Window>
