<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Orrery</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\orrery.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Orrery</Product>
    <Description>Orrery Connection Manager</Description>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\orrery.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Orrery.App.Tests" />
    <InternalsVisibleTo Include="Orrery.Screenshots" />
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
    <!-- Versioned apart from Avalonia; 12.1.1 is the newest. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <ProjectReference Include="..\Orrery.Core\Orrery.Core.csproj" />
    <ProjectReference Include="..\Orrery.Protocols.Rdp\Orrery.Protocols.Rdp.csproj" />
    <ProjectReference Include="..\Orrery.Protocols.Ssh\Orrery.Protocols.Ssh.csproj" />
    <ProjectReference Include="..\Orrery.Protocols.Vnc\Orrery.Protocols.Vnc.csproj" />
    <ProjectReference Include="..\Orrery.Protocols.Telnet\Orrery.Protocols.Telnet.csproj" />
    <ProjectReference Include="..\Orrery.Protocols.Serial\Orrery.Protocols.Serial.csproj" />
    <ProjectReference Include="..\Orrery.Protocols.Local\Orrery.Protocols.Local.csproj" />
  </ItemGroup>

  <!-- Devolutions.IronRdp's build targets add its native library for every Windows (or Linux) runtime as content
       under runtimes\<rid>\native\, by the building machine's OS rather than the target. A publish for one runtime
       already puts that runtime's library beside the app, so these copies are never loaded: drop them (about 16 MB
       of Windows DLLs in every Linux and macOS package built on Windows). Builds without a runtime keep them,
       since that's where they're found. -->
  <!-- SkiaSharp 3 and HarfBuzzSharp carry debug symbols for their native libraries (about 100 MB on Windows), which a
       publish copies beside the app. Nothing loads them, so they're left out. -->
  <Target Name="DropPackageNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And '%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
    </ItemGroup>
  </Target>

  <!-- libsodium.dll (NSec, for the vault) needs VCRUNTIME140.dll, which Windows doesn't include: without the Visual C++
       Redistributable it can't load, and Settings and the vault fail. The Windows build scripts find Microsoft's
       redistributable copy (build/Find-VcRuntime.ps1) and pass it here, so it's published beside libsodium, and in a
       single-file build it's unpacked with it. -->
  <ItemGroup Condition="'$(OrreryVcRuntimeDll)' != ''">
    <None Include="$(OrreryVcRuntimeDll)" Link="vcruntime140.dll" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="Never" />
  </ItemGroup>

  <Target Name="DropUnusedIronRdpNatives" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(RelativePath)').Replace('\', '/').StartsWith('runtimes/')) And ('%(Filename)' == 'DevolutionsIronRdp' Or '%(Filename)' == 'libDevolutionsIronRdp')" />
    </ItemGroup>
  </Target>
</Project>
