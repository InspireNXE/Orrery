<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:Avalonia.Controls.Converters"
             x:Class="Orrery.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Palette from the mockup. -->
    <SolidColorBrush x:Key="OrreryBackground" Color="#0E1014" />
    <SolidColorBrush x:Key="OrreryPanel" Color="#14161B" />
    <SolidColorBrush x:Key="OrreryInput" Color="#1B1E24" />
    <SolidColorBrush x:Key="OrreryRaised" Color="#181B21" />
    <SolidColorBrush x:Key="OrreryBorder" Color="#23272F" />
    <SolidColorBrush x:Key="OrreryControlBorder" Color="#2A2F38" />
    <!-- The three fills a row, rail button, tab or segment can have. Nothing else picks its own gray for these. -->
    <Color x:Key="OrreryHoverColor">#1C2028</Color>
    <Color x:Key="OrrerySelectedColor">#232833</Color>
    <Color x:Key="OrrerySelectedHoverColor">#282E3A</Color>
    <SolidColorBrush x:Key="OrreryHover" Color="{StaticResource OrreryHoverColor}" />
    <SolidColorBrush x:Key="OrrerySelected" Color="{StaticResource OrrerySelectedColor}" />
    <SolidColorBrush x:Key="OrrerySelectedHover" Color="{StaticResource OrrerySelectedHoverColor}" />
    <!-- The selection marker in a list that doesn't have the focus. -->
    <SolidColorBrush x:Key="OrreryMarkerIdle" Color="#5B6372" />
    <SolidColorBrush x:Key="OrreryText" Color="#E6E8EC" />
    <SolidColorBrush x:Key="OrrerySoftText" Color="#C3C9D3" />
    <SolidColorBrush x:Key="OrreryMuted" Color="#9AA3B2" />
    <!-- Colors that carry meaning. Palette.cs replaces these at start-up with brushes that follow the
         color-blind setting, and adds OrreryStateUp, OrreryStateConnecting, OrreryStateDown, OrreryStateEnded,
         OrrerySuccess and OrreryWarning. Use them as DynamicResource so they change with the setting. -->
    <SolidColorBrush x:Key="OrreryAccent" Color="#5B9DFF" />
    <SolidColorBrush x:Key="OrreryDanger" Color="#FF9AA2" />
    <SolidColorBrush x:Key="OrreryConnected" Color="#5FD38D" />
    <SolidColorBrush x:Key="OrreryFolder" Color="#E0B45A" />
    <FontFamily x:Key="OrreryMono">Cascadia Mono, Consolas, Menlo, monospace</FontFamily>

    <!-- Fluent's control colors, moved onto the palette. -->
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <SolidColorBrush x:Key="ButtonBackground" Color="#181B21" />
    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20242C" />
    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14161B" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#14161B" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#2A2F38" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#353B46" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#2A2F38" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#1F232B" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#C3C9D3" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E6E8EC" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6E8EC" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#5B6372" />
    <!-- The window buttons Avalonia draws: minimize and maximize light up in the app's hover color, and pressed,
         Fluent's light gray would hide their white glyphs. Close keeps its red. -->
    <SolidColorBrush x:Key="CaptionButtonBackground" Color="{StaticResource OrreryHoverColor}" />
    <SolidColorBrush x:Key="CaptionButtonBorderBrush" Color="{StaticResource OrrerySelectedColor}" />
    <SolidColorBrush x:Key="AccentButtonBackground" Color="#5B9DFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#76AEFF" />
    <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#4A8AE8" />
    <SolidColorBrush x:Key="AccentButtonForeground" Color="#0E1014" />
    <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="#0E1014" />
    <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#0E1014" />
    <SolidColorBrush x:Key="TextControlBackground" Color="#1B1E24" />
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#1F232A" />
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#1B1E24" />
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#16181D" />
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A2F38" />
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#353B46" />
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#5B9DFF" />
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#1F232B" />
    <SolidColorBrush x:Key="TextControlForeground" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#8A93A3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A93A3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8A93A3" />
    <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#8A93A3" />
    <SolidColorBrush x:Key="ComboBoxBackground" Color="#1B1E24" />
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1F232A" />
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#16181D" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#2A2F38" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#353B46" />
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#1F232B" />
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#181B21" />
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#2F3540" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#5B9DFF" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#76AEFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#0E1014" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#0E1014" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnDisabled" Color="#2C4466" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnDisabled" Color="#8AA6CC" />
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#5B6372" />
    <!-- Checked radio buttons and check boxes light up like the accent button, not in Fluent's much paler accent. -->
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPointerOver" Color="#76AEFF" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePointerOver" Color="#76AEFF" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedFillPressed" Color="#4A8AE8" />
    <SolidColorBrush x:Key="RadioButtonOuterEllipseCheckedStrokePressed" Color="#4A8AE8" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#76AEFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="#76AEFF" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="#4A8AE8" />
    <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="#4A8AE8" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#9AA3B2" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#181B21" />
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#2F3540" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="{StaticResource OrrerySelectedColor}" />
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#1E222B" />
    <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#C3C9D3" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#E6E8EC" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#E6E8EC" />
    <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#5B6372" />
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForeground" Color="#8A93A3" />
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPointerOver" Color="#9AA3B2" />
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundPressed" Color="#9AA3B2" />
    <SolidColorBrush x:Key="MenuFlyoutItemKeyboardAcceleratorTextForegroundDisabled" Color="#4A5160" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevron" Color="#8A93A3" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPointerOver" Color="#C3C9D3" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronPressed" Color="#C3C9D3" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronSubMenuOpened" Color="#C3C9D3" />
    <SolidColorBrush x:Key="MenuFlyoutSubItemChevronDisabled" Color="#4A5160" />
    <SolidColorBrush x:Key="ToolTipBackground" Color="#20242C" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#2F3540" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#5B9DFF" RegionColor="#0E1014" />
      </FluentTheme.Palettes>
    </FluentTheme>

    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="0.8" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource OrreryMono}" />
    </Style>

    <!-- A submenu's arrow, smaller than Fluent's 8 by 16 so it sits with 13 px text. The template sets its size, which
         a style can't change, so it's scaled. -->
    <Style Selector="MenuItem /template/ Path#PART_ChevronPath">
      <Setter Property="RenderTransform" Value="scale(0.625)" />
    </Style>

    <!-- Menus and flyouts (context menus, the session toolbar's More menu): the panel's surface with rounded corners,
         rows inset from its edge that light up as rounded pills, and quieter shortcuts and separators. -->
    <Style Selector=":is(ContextMenu), MenuFlyoutPresenter">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinWidth" Value="200" />
    </Style>
    <!-- Fluent pads a menu row 4 px above and 7 below, which sets the text and arrow high; the same height, evenly. -->
    <Style Selector="MenuItem">
      <Setter Property="Padding" Value="10,6.5" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector=":is(ContextMenu) Separator, MenuFlyoutPresenter Separator">
      <Setter Property="Background" Value="#2A2F38" />
      <Setter Property="Margin" Value="6,4" />
    </Style>

    <!-- Small bordered buttons, as in the mockup's session toolbar. -->
    <Style Selector="Button">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.accent">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#2A1A1D" />
      <Setter Property="BorderBrush" Value="#4A2A2E" />
      <Setter Property="Foreground" Value="{DynamicResource OrreryDanger}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3A2025" />
      <Setter Property="BorderBrush" Value="#5E343A" />
      <Setter Property="Foreground" Value="#FFB8BE" />
    </Style>

    <!-- The session toolbar's "REC 1:23" pill while a tab records. -->
    <Style Selector="Button.rec">
      <Setter Property="Background" Value="#2A1A1D" />
      <Setter Property="BorderBrush" Value="#5E343A" />
      <Setter Property="Foreground" Value="#FFB8BE" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,0,12,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rec:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3A2025" />
      <Setter Property="BorderBrush" Value="#7A3E46" />
      <Setter Property="Foreground" Value="#FFD0D4" />
    </Style>

    <!-- Panels that open from a button (the recording pill's), drawn like the menus. -->
    <Style Selector="FlyoutPresenter">
      <Setter Property="Background" Value="#181B21" />
      <Setter Property="BorderBrush" Value="#2F3540" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Borderless icon buttons: the rail, the tree header, tab close. -->
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <!-- Small square icon buttons beside the tabs and in the session toolbar. -->
    <Style Selector="Button.small">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Where you are: everything you navigate (the rail, the tree, side lists, settings pages, quick connect, session
         tabs) shows its current item with the selected fill and this blue marker. The marker's place says "this one"
         without relying on its color, and it goes gray while its list doesn't have the focus. Toggle groups use
         Button.segment instead, and never the marker. -->
    <Style Selector="Border.marker">
      <Setter Property="Width" Value="3" />
      <Setter Property="Height" Value="16" />
      <Setter Property="CornerRadius" Value="2" />
      <Setter Property="Margin" Value="4,0,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource OrreryAccent}" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <!-- On a tab the marker lies along the top, over the tab's outline. -->
    <Style Selector="Border.marker.top">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="3" />
      <Setter Property="Margin" Value="0,-1,0,0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <!-- A row built in code (quick connect's results): a Border.row holding a Border.marker. -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="{StaticResource OrrerySelected}" />
    </Style>
    <Style Selector="Border.row.selected Border.marker">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The rail: the open panel's button has the selected fill, the marker on its left edge and a blue icon. -->
    <Style Selector="Button.rail">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_Marker" Classes="marker" Margin="0" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.rail.active">
      <Setter Property="Background" Value="{StaticResource OrrerySelected}" />
      <Setter Property="Foreground" Value="{DynamicResource OrreryAccent}" />
    </Style>
    <Style Selector="Button.rail.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrrerySelectedHover}" />
      <Setter Property="Foreground" Value="{DynamicResource OrreryAccent}" />
    </Style>
    <Style Selector="Button.rail.active /template/ Border#PART_Marker">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- The title bar's quick connect box: a button that looks like a search field. -->
    <Style Selector="Button.search">
      <Setter Property="Background" Value="{StaticResource OrreryRaised}" />
      <Setter Property="BorderBrush" Value="{StaticResource OrreryControlBorder}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.search:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
      <Setter Property="BorderBrush" Value="#353B46" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
    </Style>

    <!-- Session tabs: open on the session below, with the marker along the top of the current one. Every tab has the
         same outline and overlap, only drawn on the current one, so choosing a tab moves nothing. -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1,1,1,0" />
      <Setter Property="CornerRadius" Value="8,8,0,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Margin" Value="0,0,0,-1" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource OrrerySoftText}" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Background" Value="{StaticResource OrreryBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource OrreryControlBorder}" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="Button.tab.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryBackground}" />
      <Setter Property="BorderBrush" Value="{StaticResource OrreryControlBorder}" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="Button.tab.selected Border.marker">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Button.tabclose">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!-- A saved setting's row: its name and value on one line, opened with a click to change it. -->
    <Style Selector="Button.setting">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="Margin" Value="-8,0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.setting:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
    </Style>
    <!-- Which option is on: toggle groups (the settings pane's Saved settings and This session, the frame rates) side by
         side in a dark strip. The one that's on has the selected fill and a hairline, never the marker, and keeps its
         weight; the hairline is there, unseen, on every segment so none changes size. -->
    <Style Selector="Border.segments">
      <Setter Property="Background" Value="{StaticResource OrreryBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Button.segment">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource OrreryMuted}" />
    </Style>
    <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="Button.segment.selected">
      <Setter Property="Background" Value="{StaticResource OrrerySelected}" />
      <Setter Property="BorderBrush" Value="{StaticResource OrreryControlBorder}" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="Button.segment.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrrerySelectedHover}" />
      <Setter Property="BorderBrush" Value="{StaticResource OrreryControlBorder}" />
    </Style>
    <!-- A text-only action, such as "Use that instead". -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#8FB4FF" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1C2533" />
      <Setter Property="Foreground" Value="#B9D0FF" />
    </Style>

    <!-- Connection tree rows: rounded, with the selected fill and the marker on selected rows.
         Fluent's row, with the marker added at the row's left edge, before the indent. Rows have no border, and the
         drop lines are inset shadows, so no state changes a row's size or moves its text. (Avalonia draws shadows only
         on a border that's even all round.) -->
    <Style Selector="TreeView#Tree TreeViewItem">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="0" />
      <!-- On the item, which the template binds the row's border to; a setter on the row loses to that. -->
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Template">
        <ControlTemplate>
          <StackPanel>
            <Border Name="PART_LayoutRoot"
                    Classes="TreeViewItemLayoutRoot"
                    Focusable="True"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    MinHeight="{TemplateBinding MinHeight}"
                    TemplatedControl.IsTemplateFocusTarget="True">
              <Panel>
                <Grid Name="PART_Header" ColumnDefinitions="Auto, *">
                  <Grid.Margin>
                    <MultiBinding Converter="{x:Static converters:TreeViewItemIndentConverter.Instance}">
                      <Binding Path="Level" RelativeSource="{RelativeSource TemplatedParent}" />
                      <DynamicResource ResourceKey="TreeViewItemIndent" />
                    </MultiBinding>
                  </Grid.Margin>
                  <Panel Name="PART_ExpandCollapseChevronContainer"
                         Margin="{StaticResource TreeViewItemExpandCollapseChevronMargin}">
                    <ToggleButton Name="PART_ExpandCollapseChevron"
                                  Theme="{StaticResource FluentTreeViewExpandCollapseChevron}"
                                  Focusable="False"
                                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}" />
                  </Panel>
                  <ContentPresenter Name="PART_HeaderPresenter"
                                    Grid.Column="1"
                                    Focusable="False"
                                    Background="Transparent"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    Margin="{TemplateBinding Padding}" />
                </Grid>
                <Border Name="PART_Marker" Classes="marker" />
              </Panel>
            </Border>
            <ItemsPresenter Name="PART_ItemsPresenter"
                            IsVisible="{TemplateBinding IsExpanded}"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
          </StackPanel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem:selected /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{StaticResource OrrerySelected}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
      <Setter Property="Background" Value="{StaticResource OrrerySelectedHover}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem:selected /template/ Border#PART_Marker">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TreeView#Tree:not(:focus-within) TreeViewItem:selected /template/ Border#PART_Marker">
      <Setter Property="Background" Value="{StaticResource OrreryMarkerIdle}" />
    </Style>
    <!-- Where a dragged row will land: a line above or below the row, or the row lit up to go into it. -->
    <Style Selector="TreeView#Tree TreeViewItem.drop-before /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="inset 0 2 0 0 #5B9DFF" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem.drop-after /template/ Border#PART_LayoutRoot">
      <Setter Property="BoxShadow" Value="inset 0 -2 0 0 #5B9DFF" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem.drop-into /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="#1A2433" />
      <Setter Property="BoxShadow" Value="inset 2 0 0 0 #5B9DFF" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{StaticResource OrrerySoftText}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem /template/ ContentPresenter#PART_Header">
      <Setter Property="Foreground" Value="{StaticResource OrrerySoftText}" />
    </Style>
    <Style Selector="TreeView#Tree TreeViewItem:selected /template/ ContentPresenter#PART_Header">
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>

    <!-- Lists in the side panel (credentials, recent, recordings, settings pages) match the connection tree's rows. -->
    <Style Selector="ListBox.side ListBoxItem">
      <Setter Property="Padding" Value="14,2,8,2" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{StaticResource OrrerySoftText}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}"
                              CornerRadius="{TemplateBinding CornerRadius}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Content="{TemplateBinding Content}"
                              Padding="{TemplateBinding Padding}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <Border Name="PART_Marker" Classes="marker" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="ListBox.side ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrreryHover}" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="ListBox.side ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrrerySelected}" />
      <Setter Property="Foreground" Value="{StaticResource OrreryText}" />
    </Style>
    <Style Selector="ListBox.side ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource OrrerySelectedHover}" />
    </Style>
    <Style Selector="ListBox.side ListBoxItem:selected /template/ Border#PART_Marker">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ListBox.side:not(:focus-within) ListBoxItem:selected /template/ Border#PART_Marker">
      <Setter Property="Background" Value="{StaticResource OrreryMarkerIdle}" />
    </Style>

    <!-- The player's volume: a slim slider with a small thumb, so it sits quietly beside the other controls. -->
    <Style Selector="Slider.volume">
      <Setter Property="MinHeight" Value="0" />
      <Style.Resources>
        <x:Double x:Key="SliderHorizontalThumbWidth">12</x:Double>
        <x:Double x:Key="SliderHorizontalThumbHeight">12</x:Double>
        <x:Double x:Key="SliderHorizontalHeight">24</x:Double>
      </Style.Resources>
    </Style>

    <Style Selector="ToolTip">
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Application.Styles>
</Application>
