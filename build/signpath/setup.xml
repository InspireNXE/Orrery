<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "setup": Orrery Setup, built from the files signed under "files" and sent second.
  Paste it into the SignPath project as the artifact configuration with the slug "setup".
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file-set>
      <include path="Orrery-Setup-*.exe" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
